  "components": {
    "securitySchemes": {
      "operatorBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Locally configured opaque operator token; never embed in the public frontend."
      }
    },
    "schemas": {
      "Region": {
        "type": "string",
        "enum": [
          "NSW1",
          "QLD1",
          "SA1",
          "TAS1",
          "VIC1"
        ]
      },
      "DayCoverage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "day",
          "availability",
          "revision",
          "retrievedAt",
          "valid",
          "missing",
          "sourceNull"
        ],
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "availability": {
            "type": "string",
            "enum": [
              "NOT_IMPORTED",
              "COMPLETE",
              "INCOMPLETE"
            ]
          },
          "revision": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "valid": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "maximum": 288
          },
          "missing": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "maximum": 288
          },
          "sourceNull": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "maximum": 288
          }
        },
        "description": "NOT_IMPORTED has null revision, retrievedAt and counts. Imported days have a revision and timestamp; valid + missing + sourceNull = 288. COMPLETE means valid = 288; otherwise INCOMPLETE. Retrieved time is an instant, not a market date."
      },
      "Coverage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region",
          "start",
          "endExclusive",
