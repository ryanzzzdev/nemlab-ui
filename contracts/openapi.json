{
  "openapi": "3.0.3",
  "info": {
    "title": "NEMLab shared API",
    "version": "1.0.0",
    "description": "Enabled price-read and operator surfaces. Features are independently opt-in; disabled routes return 404. All market dates use fixed UTC+10, not daylight saving. Operator credentials must remain in trusted operator tooling. No simulation or GridReplay API is implemented here."
  },
  "paths": {
    "/api/v1/prices/{region}/coverage": {
      "get": {
        "operationId": "getPriceCoverage",
        "summary": "Coverage for 1\u201331 completed NEM days since 2021-10-01",
        "security": [],
        "parameters": [
          {
            "name": "region",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Region"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "ISO date in fixed UTC+10. Start/day must be since 2021-10-01 and before today; endExclusive must be after start and no later than today. Coverage spans at most 31 days."
          },
          {
            "name": "endExclusive",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "ISO date in fixed UTC+10. Start/day must be since 2021-10-01 and before today; endExclusive must be after start and no later than today. Coverage spans at most 31 days."
          }
        ],
        "responses": {
          "200": {
            "description": "Includes NOT_IMPORTED days with null revision and counts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Coverage"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "no-store"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "INVALID_REQUEST"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "STORAGE_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "STORAGE_UNAVAILABLE"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/prices/{region}/{day}": {
      "get": {
        "operationId": "getPriceDay",
        "summary": "Current immutable revision of one completed NEM price day",
        "security": [],
