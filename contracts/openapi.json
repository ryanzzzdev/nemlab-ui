            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "ISO date in fixed UTC+10. Start/day must be since 2021-10-01 and before today; endExclusive must be after start and no later than today. Coverage spans at most 31 days."
          }
        ],
        "responses": {
          "200": {
            "description": "288 intervals; exact prices are decimal strings and gap prices are null",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Series"
                }
              }
            },
            "headers": {
