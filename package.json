{
  "name": "nemlab-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "npm run dev --workspace @nemlab/public",
    "dev:admin": "npm run dev --workspace @nemlab/admin",
    "build": "tsc --project tsconfig.tools.json && npm run build --workspace @nemlab/public && npm run build --workspace @nemlab/admin",
    "preview": "npm run preview --workspace @nemlab/public",
    "preview:admin": "npm run preview --workspace @nemlab/admin",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "playwright test",
    "test:admin": "playwright test --config playwright.admin.config.ts",
    "check": "npm run contract:check && npm run format:check && npm run build && npm run test:browser && npm run test:admin",
    "contract:sync": "node scripts/contract.mjs --sync",
    "contract:check": "node scripts/contract.mjs",
    "test:live": "python3 scripts/test-live.py"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
